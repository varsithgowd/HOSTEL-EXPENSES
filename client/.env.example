# In development with Vite proxy, leave empty or use http://localhost:5000/api
# For Mobile/LAN testing on same Wi-Fi, set to your machine's LAN IP:
# e.g. VITE_API_URL=http://192.168.1.100:5000/api
# In production on Vercel, set to your Render backend API URL:
# e.g. VITE_API_URL=https://hostel-expenses.onrender.com/api
VITE_API_URL=

